@* MyFav1 content card: optional header (title + actions), body, optional footer. *@
<div class="card @Class">
    @if (Title is not null || HeaderActions is not null)
    {
        <div class="card-header d-flex justify-content-between align-items-center gap-2 @(Divider ? "border-bottom border-dashed" : "")">
            <div>
                <h4 class="header-title">@Title</h4>
                @if (Subtitle is not null)
                {
                    <p class="text-muted fs-12 mb-0 mt-1">@Subtitle</p>
                }
            </div>
            @HeaderActions
        </div>
    }
    <div class="card-body @BodyClass">@ChildContent</div>
    @if (Footer is not null)
    {
        <div class="card-footer border-top border-dashed">@Footer</div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    /// <summary>Dashed line under the header (used when the body starts with plain content).</summary>
    [Parameter] public bool Divider { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? BodyClass { get; set; }
}
