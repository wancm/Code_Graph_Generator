@page "/readme"
@* README.md (copied next to the app at build time), formatted with Markdig. *@
@{
    ReadmePage page = ReadmeRender.Read();
}
<div class="page-title-head">
    <div class="flex-grow-1">
        <h4 class="page-title"><MfTerm Term="Glossary.Readme" /></h4>
        <p class="text-muted mb-0 fs-13">This app's guide: what it does, how to start it, and how the code graph is built.</p>
    </div>
    @if (page.ChangedAt is { } changed)
    {
        <span class="text-muted fs-12" title="@Exact(changed)">Last changed @Ago(changed)</span>
    }
</div>
<div class="card">
    <div class="card-body markdown-body">
        @((MarkupString)page.Html)
    </div>
</div>

@code {
    private static string Exact(DateTime at) =>
        $"{at:yyyy-MM-dd HH:mm:ss} ({TimeZoneInfo.Local.Id})";

    private static string Ago(DateTime at)
    {
        TimeSpan age = DateTime.Now - at;
        return age.TotalSeconds < 60 ? $"{Math.Max(0, (int)age.TotalSeconds)}s ago"
            : age.TotalMinutes < 60 ? $"{(int)age.TotalMinutes}m ago"
            : age.TotalHours < 24 ? $"{(int)age.TotalHours}h ago"
            : $"{(int)age.TotalDays}d ago";
    }
}
